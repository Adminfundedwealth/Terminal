# ============================================================
# FUNDEDWEALTH TERMINAL — ENVIRONMENT CONFIGURATION
# ============================================================
# ALL VARIABLES MARKED (REQUIRED) MUST BE SET. Server will refuse to start without them.

# --- Supabase (REQUIRED) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# --- Authentication (REQUIRED — no defaults, no fallbacks) ---
JWT_SECRET=generate-with-node-e-console-log-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRY=24h
SSO_SHARED_SECRET=generate-with-node-e-console-log-require-crypto-randomBytes-64-toString-hex
SSO_API_KEY=your-sso-api-key-shared-with-main-site-backend

# --- Founder Authorization (REQUIRED for kill switch / emergency controls) ---
# Comma-separated list of user IDs that have founder-level access
FOUNDER_USER_IDS=founder-user-id-1,founder-user-id-2

# --- FundedWealth Dashboard ---
FW_DASHBOARD_URL=https://fundedwealth.com
TERMINAL_URL=https://terminal.fundedwealth.com

# --- Server (REQUIRED) ---
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://terminal.fundedwealth.com

# --- Redis (REQUIRED for multi-instance rate limiting & nonce store) ---
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_PASSWORD=your-redis-password

# --- Broker Credential Encryption (REQUIRED) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=your-64-hex-char-key-32-bytes

# --- Broker Credentials (configure per broker adapter) ---
# ANGEL_API_KEY=
# ANGEL_CLIENT_ID=
# ANGEL_PASSWORD=
# ANGEL_TOTP_SECRET=
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=

# --- Provisioning API (REQUIRED — shared with Website + Admin backends) ---
PROVISIONING_API_KEY=your-provisioning-api-key-shared-with-website-and-admin

# --- Website Callback (Terminal → Website after provisioning) ---
WEBSITE_API_URL=https://fundedwealth.com/api
WEBSITE_CALLBACK_KEY=your-callback-key-shared-with-website

# --- Admin Callback (Terminal → Admin after provisioning/lifecycle events) ---
ADMIN_API_URL=https://admin.fundedwealth.com/api
ADMIN_CALLBACK_KEY=your-admin-callback-key-shared-with-admin

# --- Email ---
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@fundedwealth.com
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
